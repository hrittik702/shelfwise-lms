<nav
  class="navbar navbar-expand-lg border-bottom sticky-top py-2 navbar-shelfwise"
>
  <div class="container">
    <!-- Brand on the left -->
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <img
        src="/assets/logo.png"
        alt="ShelfWise Logo"
        width="36"
        height="36"
        class="d-inline-block rounded-2"
      />
      <span class="brand-title">ShelfWise</span>
    </a>

    <!-- Responsive Toggler for Mobile -->
    <button
      class="navbar-toggler border-0 shadow-none"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#shelfwiseNavbar"
      aria-controls="shelfwiseNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navigation & Action Regions -->
    <% if(locals.currUser) {%>
    <div class="collapse navbar-collapse" id="shelfwiseNavbar">
      <!-- Centered Navigation Links -->
      <ul class="navbar-nav mx-auto text-center my-2 my-lg-0">
        <li class="nav-item">
          <a class="nav-link px-3" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link px-3" href="/books">Books</a>
        </li>
        <li class="nav-item">
          <a class="nav-link px-3" href="/members">Members</a>
        </li>
        <li class="nav-item">
          <a class="nav-link px-3" href="/circulation">Issues</a>
        </li>
      </ul>

      <!-- Right-aligned Staff Menu -->
      <div class="navbar-nav-action text-center text-lg-end my-2 my-lg-0">
        <div class="dropdown d-inline-block">
          <button
            class="btn btn-brand px-3 py-2 fw-semibold rounded-pill dropdown-toggle d-inline-flex align-items-center gap-2"
            type="button"
            id="staffDropdownMenu"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            <i class="bi bi-person-circle fs-6"></i>
            <span><%= currUser.name %></span>
          </button>

          <ul
            class="dropdown-menu dropdown-menu-end shadow-sm border p-2 mt-2"
            aria-labelledby="staffDropdownMenu"
          >
            <!-- Staff Information Header -->
            <li class="px-3 py-2 text-start">
              <div class="fw-bold text-dark"><%= currUser.name %></div>
              <div class="small text-secondary">
                <%= currUser.username ? '@' + currUser.username : (currUser.id ? 'Staff ID: #' + currUser.id : 'Library Staff') %>
              </div>
            </li>
            <li><hr class="dropdown-divider my-1" /></li>

            <!-- Option 1: Add new account -->
            <li>
              <a
                class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2"
                href="/staff/signup"
              >
                <i class="bi bi-person-plus text-secondary"></i>
                <span>Add new account</span>
              </a>
            </li>

            <!-- Option 2: Log Out -->
            <li>
              <form
                action="/staff/logout"
                method="get"
                data-confirm="Are you sure you want to sign out of your staff session?"
                data-btn="Sign Out"
                data-title="Sign Out"
                data-variant="danger"
                class="m-0"
              >
                <button
                  type="submit"
                  class="dropdown-item d-flex align-items-center gap-2 py-2 rounded-2 text-danger"
                >
                  <i class="bi bi-box-arrow-right text-danger"></i>
                  <span>Log Out</span>
                </button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <% } else {%>
    <div class="navbar-nav-action text-center text-lg-end my-2 my-lg-0">
      <a
        href="/staff/login"
        class="btn btn-brand px-4 py-2 fw-semibold rounded-pill text-decoration-none"
      >
        Sign Up
      </a>
    </div>
    <% } %>
  </div>
</nav>
