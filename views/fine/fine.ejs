<% layout('/layout/boilerplate') %>

<div class="fine-page container py-4 py-lg-5">
  <%
    const fmt = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
  %>

  <!-- Page Heading -->
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
      <h1 class="fine-title h3 fw-bold mb-1">Fine Transactions</h1>
      <p class="text-secondary mb-0">Monitor overdue penalties, collect fees, and manage library accounts.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button
        type="button"
        class="fine-btn-primary"
        data-bs-toggle="modal"
        data-bs-target="#recordFineModal"
      >
        <i class="bi bi-plus-lg fine-btn-icon-gold me-1" aria-hidden="true"></i>
        <span>Assess Fine</span>
      </button>
      <a href="/circulation" class="fine-btn-secondary">
        <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i>
        <span>Circulation</span>
      </a>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="fine-summary-card p-3 p-md-4 h-100 bg-white <%= stats.unpaidAmount > 0 ? 'fine-card-unpaid' : '' %>">
        <div class="text-secondary small fw-medium mb-1">Outstanding Dues</div>
        <div class="fs-2 fw-bold <%= stats.unpaidAmount > 0 ? 'text-danger font-monospace' : 'text-dark font-monospace' %>">
          ₹<%= stats.unpaidAmount.toLocaleString('en-IN') %>
        </div>
        <div class="small <%= stats.unpaidAmount > 0 ? 'text-danger' : 'text-secondary' %> mt-1">
          <%= stats.unpaidCount %> unpaid <%= stats.unpaidCount === 1 ? 'account' : 'accounts' %>
        </div>
      </div>
    </div>

    <div class="col-6 col-md-3">
      <div class="fine-summary-card p-3 p-md-4 h-100 bg-white">
        <div class="text-secondary small fw-medium mb-1">Collected Revenue</div>
        <div class="fs-2 fw-bold text-success font-monospace">
          ₹<%= stats.paidAmount.toLocaleString('en-IN') %>
        </div>
        <div class="small text-secondary mt-1">
          <%= stats.paidCount %> <%= stats.paidCount === 1 ? 'fee' : 'fees' %> settled
        </div>
      </div>
    </div>

    <div class="col-6 col-md-3">
      <div class="fine-summary-card p-3 p-md-4 h-100 bg-white">
        <div class="text-secondary small fw-medium mb-1">Total Assessed</div>
        <div class="fs-2 fw-bold text-dark font-monospace">
          ₹<%= stats.totalAmount.toLocaleString('en-IN') %>
        </div>
        <div class="small text-secondary mt-1">
          Across <%= stats.totalFines %> <%= stats.totalFines === 1 ? 'record' : 'records' %>
        </div>
      </div>
    </div>

    <div class="col-6 col-md-3">
      <div class="fine-summary-card p-3 p-md-4 h-100 bg-white <%= stats.activeOverdueLoansCount > 0 ? 'fine-card-overdue' : '' %>">
        <div class="text-secondary small fw-medium mb-1">Active Overdue Loans</div>
        <div class="fs-2 fw-bold <%= stats.activeOverdueLoansCount > 0 ? 'text-warning-emphasis' : 'text-dark' %> font-monospace">
          <%= stats.activeOverdueLoansCount %>
        </div>
        <div class="small text-secondary mt-1">
          <a href="/circulation" class="text-decoration-none">
            Review circulation &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Active Overdue Loans Notice Banner (if applicable) -->
  <% if (stats.activeOverdueLoansCount > 0) { %>
    <div class="alert alert-warning border-0 rounded-4 shadow-sm p-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-clock-history fs-5 text-warning-emphasis" aria-hidden="true"></i>
        <div class="small text-dark">
          There <%= stats.activeOverdueLoansCount === 1 ? 'is' : 'are' %> currently <strong><%= stats.activeOverdueLoansCount %> unreturned <%= stats.activeOverdueLoansCount === 1 ? 'loan' : 'loans' %></strong> past due date in circulation. Overdue fines accumulate at ₹2/day and are recorded upon book return.
        </div>
      </div>
      <a href="/circulation" class="btn btn-outline-dark btn-sm px-3">
        View Overdue Loans
      </a>
    </div>
  <% } %>

  <!-- Search & Filter Controls -->
  <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <div class="row g-2 align-items-center">
      <div class="col-12 col-md-4">
        <div class="fine-search-box">
          <i class="bi bi-search fine-search-icon" aria-hidden="true"></i>
          <label for="fineDirectorySearch" class="visually-hidden">Search fines</label>
          <input
            type="search"
            id="fineDirectorySearch"
            class="form-control form-control-sm fine-search-input"
            placeholder="Search by member, book title, fine ID, phone, or ISBN..."
            aria-label="Search fines"
          >
        </div>
      </div>

      <div class="col-6 col-md-3">
        <label for="fineStatusFilter" class="visually-hidden">Filter by status</label>
        <select id="fineStatusFilter" class="form-select form-select-sm" aria-label="Filter by payment status">
          <option value="">All Payment (Unpaid &amp; Paid)</option>
          <option value="unpaid">Unpaid Dues Only</option>
          <option value="paid">Settled / Paid Only</option>
        </select>
      </div>

      <div class="col-6 col-md-3">
        <label for="fineReturnFilter" class="visually-hidden">Filter by return status</label>
        <select id="fineReturnFilter" class="form-select form-select-sm" aria-label="Filter by return status">
          <option value="">All Books (On Loan &amp; Returned)</option>
          <option value="unreturned">Book On Loan (Not Returned)</option>
          <option value="returned">Book Returned</option>
        </select>
      </div>

      <div class="col-12 col-md-2">
        <button type="button" id="resetFineFiltersBtn" class="btn btn-outline-secondary btn-sm w-100">
          <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i> Reset
        </button>
      </div>
    </div>
  </div>

  <!-- Fine Transactions Table -->
  <div class="table-responsive fine-table-wrapper rounded-3 shadow-sm border mb-3">
    <table class="table table-hover table-striped align-middle mb-0 fine-table" id="fineTable">
      <thead>
        <tr>
          <th scope="col" class="ps-3 text-center" style="width: 55px;">S.No.</th>
          <th scope="col" class="text-center" style="width: 85px;">Fine ID</th>
          <th scope="col">Member</th>
          <th scope="col">Book Title</th>
          <th scope="col">Timeline &amp; Return</th>
          <th scope="col" class="text-end" style="width: 100px;">Amount</th>
          <th scope="col" class="text-center" style="width: 135px;">Payment</th>
          <th scope="col" class="pe-3 text-end" style="width: 180px;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (fines.length > 0) { %>
          <% fines.forEach((fine, index) => { %>
            <%
              const isUnpaid = fine.paid_status === 'unpaid';
              const daysLate = Math.max(0, Number(fine.days_overdue) || 0);
            %>
            <tr
              class="fine-row"
              data-id="<%= fine.fine_id %>"
              data-member="<%= (fine.member_name || '').toLowerCase() %>"
              data-book="<%= (fine.book_title || '').toLowerCase() %>"
              data-isbn="<%= (fine.isbn || '').toLowerCase() %>"
              data-phone="<%= (fine.member_phone || '').toLowerCase() %>"
              data-email="<%= (fine.member_email || '').toLowerCase() %>"
              data-status="<%= fine.paid_status %>"
              data-role="<%= (fine.member_type || '').toLowerCase() %>"
              data-returned="<%= fine.return_date ? 'returned' : 'unreturned' %>"
            >
              <td class="ps-3 text-center text-secondary small"><%= index + 1 %></td>

              <td class="text-center font-monospace small fw-semibold text-secondary">
                #<%= fine.fine_id %>
              </td>

              <td>
                <div class="fw-semibold">
                  <a href="/members/<%= fine.member_id %>" class="fine-link text-decoration-none" title="View <%= fine.member_name %> profile">
                    <%= fine.member_name %>
                  </a>
                </div>
                <div class="d-flex align-items-center gap-1 mt-1 small">
                  <span class="badge rounded-pill text-bg-light border text-dark fw-normal text-capitalize">
                    <%= fine.member_type %>
                  </span>
                  <span class="text-secondary font-monospace"><%= fine.member_phone || fine.member_email || '' %></span>
                </div>
              </td>

              <td>
                <div class="fw-medium text-dark text-break">
                  <a href="/books/<%= fine.book_id %>" class="fine-link text-decoration-none" title="View book details">
                    <%= fine.book_title %>
                  </a>
                </div>
                <div class="text-secondary small font-monospace">
                  ISBN: <%= fine.isbn %>
                </div>
              </td>

              <td class="small">
                <div class="text-secondary mb-1">
                  Due: <span class="text-dark fw-medium"><%= fmt(fine.due_date) %></span>
                </div>
                <% if (fine.return_date) { %>
                  <div class="d-flex align-items-center flex-wrap gap-1">
                    <span class="badge rounded-pill text-bg-light border text-success fw-normal">
                      <i class="bi bi-box-arrow-in-down me-1" aria-hidden="true"></i>Returned <%= fmt(fine.return_date) %>
                    </span>
                    <% if (daysLate > 0) { %>
                      <span class="text-danger small font-monospace">(<%= daysLate %>d late)</span>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="d-flex align-items-center flex-wrap gap-1">
                    <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis border border-danger-subtle fw-normal">
                      <i class="bi bi-book me-1" aria-hidden="true"></i>Not Returned (On Loan)
                    </span>
                    <% if (daysLate > 0) { %>
                      <span class="text-danger small fw-semibold font-monospace">(<%= daysLate %>d overdue)</span>
                    <% } %>
                  </div>
                <% } %>
              </td>

              <td class="text-end">
                <span class="font-monospace fw-bold fs-6 <%= isUnpaid ? 'text-danger' : 'text-dark' %>">
                  ₹<%= fine.amount %>
                </span>
              </td>

              <td class="text-center text-nowrap">
                <% if (isUnpaid) { %>
                  <span class="circ-status-badge circ-status-overdue" title="Overdue fee pending collection">
                    <i class="bi bi-clock-history me-1" aria-hidden="true"></i>Unpaid
                  </span>
                <% } else { %>
                  <span class="circ-status-badge circ-status-active" title="Settled on <%= fmt(fine.paid_date) %>">
                    <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>Paid <%= fmt(fine.paid_date) %>
                  </span>
                <% } %>
              </td>

              <td class="pe-3 text-end text-nowrap">
                <div class="d-inline-flex align-items-center justify-content-end gap-1">
                  <% if (!fine.return_date) { %>
                    <a
                      href="/circulation/<%= fine.issue_id %>/return"
                      class="fine-btn-return text-decoration-none"
                      title="Process book return in circulation"
                    >
                      <i class="bi bi-arrow-return-left me-1" aria-hidden="true"></i>
                      <span>Return</span>
                    </a>
                  <% } %>

                  <% if (isUnpaid) { %>
                    <form
                      action="/fine/<%= fine.fine_id %>/pay"
                      method="POST"
                      class="d-inline m-0 p-0"
                      data-confirm="Confirm collection of ₹<%= fine.amount %> from <%= fine.member_name %> for '&ldquo;<%= fine.book_title %>&rdquo;'? This will settle their library fine."
                      data-btn="Collect ₹<%= fine.amount %>"
                      data-title="Confirm Fine Settlement"
                      data-variant="success"
                    >
                      <button type="submit" class="fine-btn-collect" title="Collect ₹<%= fine.amount %> fine">
                        <i class="bi bi-cash-stack me-1" aria-hidden="true"></i>
                        <span>Collect</span>
                      </button>
                    </form>
                  <% } else { %>
                    <span class="fine-settled-pill small text-secondary">
                      <i class="bi bi-check2 text-success me-1" aria-hidden="true"></i>Settled
                    </span>
                    <form
                      action="/fine/<%= fine.fine_id %>/unpay"
                      method="POST"
                      class="d-inline m-0 p-0"
                      data-confirm="Revert Fine #<%= fine.fine_id %> for <%= fine.member_name %> back to unpaid status?"
                      data-btn="Revert to Unpaid"
                      data-title="Revert Payment Status"
                      data-variant="warning"
                    >
                      <button type="submit" class="fine-btn-unpay" title="Revert to unpaid status">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        <span class="visually-hidden">Revert to unpaid</span>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center py-5">
              <i class="bi bi-shield-check fs-2 text-success mb-2 d-block" aria-hidden="true"></i>
              <h2 class="h5 fw-bold mb-1 text-dark">No Fine Transactions</h2>
              <p class="text-secondary small mb-3">All member accounts are currently in good standing with zero assessed dues.</p>
              <a href="/circulation" class="btn btn-outline-success btn-sm px-3">
                <i class="bi bi-journal-check me-1" aria-hidden="true"></i> View Circulation Records
              </a>
            </td>
          </tr>
        <% } %>
        <tr id="fineSearchEmpty" class="d-none">
          <td colspan="8" class="text-center py-5">
            <i class="bi bi-search fs-3 text-secondary mb-2 d-block" aria-hidden="true"></i>
            <h2 class="h6 fw-bold mb-1 text-dark">No matching fine records found</h2>
            <p class="text-secondary small mb-0">Try adjusting your search criteria or resetting filters.</p>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Assess / Record Fine Modal -->
  <div class="modal fade" id="recordFineModal" tabindex="-1" aria-labelledby="recordFineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0 shadow">
        <div class="modal-header border-bottom p-3 p-md-4">
          <h5 class="modal-title fw-bold text-dark" id="recordFineModalLabel">
            <i class="bi bi-receipt-cutoff me-2 text-success" aria-hidden="true"></i>
            Assess Library Fine
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <form action="/fine/record" method="POST" id="assessFineForm">
          <div class="modal-body p-3 p-md-4">
            <div class="mb-3">
              <label for="issueSelect" class="form-label small fw-semibold text-secondary">
                Select Circulation Record <span class="text-danger">*</span>
              </label>
              <% if (eligibleIssues && eligibleIssues.length > 0) { %>
                <select name="issue_id" id="issueSelect" class="form-select" required>
                  <option value="" disabled selected>Choose a circulation loan...</option>
                  <% eligibleIssues.forEach(iss => { %>
                    <%
                      const isPast = (Number(iss.days_overdue) || 0) > 0;
                      const estAmt = isPast ? Math.max(0, Number(iss.days_overdue) * 2) : 0;
                    %>
                    <option value="<%= iss.issue_id %>" data-days="<%= iss.days_overdue %>" data-est="<%= estAmt %>">
                      #<%= iss.issue_id %>: <%= iss.member_name %> — <%= iss.book_title %>
                      (<%= isPast ? iss.days_overdue + 'd late' : 'Due ' + fmt(iss.due_date) %>)
                    </option>
                  <% }) %>
                </select>
              <% } else { %>
                <div class="alert alert-light border small text-secondary">
                  No active circulation records available for assessment.
                </div>
              <% } %>
              <div class="form-text small">Select the borrowing transaction to attach this charge to.</div>
            </div>

            <div class="mb-3">
              <label for="fineAmountInput" class="form-label small fw-semibold text-secondary">
                Fine Amount (₹) <span class="text-danger">*</span>
              </label>
              <div class="input-group">
                <span class="input-group-text bg-light fw-bold text-secondary">₹</span>
                <input
                  type="number"
                  name="amount"
                  id="fineAmountInput"
                  class="form-control font-monospace"
                  min="1"
                  step="1"
                  placeholder="e.g. 20"
                  required
                >
              </div>
              <div class="form-text small">Standard rate: ₹2 per overdue day.</div>
            </div>

            <div class="mb-2">
              <label class="form-label small fw-semibold text-secondary d-block">
                Initial Payment Status
              </label>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="paid_status" id="statusUnpaid" value="unpaid" checked>
                <label class="form-check-label small" for="statusUnpaid">
                  <span class="badge text-bg-danger-subtle text-danger border border-danger-subtle">Unpaid (Pending Dues)</span>
                </label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="paid_status" id="statusPaid" value="paid">
                <label class="form-check-label small" for="statusPaid">
                  <span class="badge text-bg-success-subtle text-success border border-success-subtle">Paid Immediately</span>
                </label>
              </div>
            </div>
          </div>

          <div class="modal-footer border-top p-3 d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="fine-btn-primary">
              <i class="bi bi-check-lg fine-btn-icon-gold me-1" aria-hidden="true"></i>
              <span>Save Fine Record</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Live Client-side Filter Script -->
  <script>
    (function () {
      const searchInput = document.getElementById('fineDirectorySearch');
      const statusFilter = document.getElementById('fineStatusFilter');
      const returnFilter = document.getElementById('fineReturnFilter');
      const resetBtn = document.getElementById('resetFineFiltersBtn');
      const rows = Array.from(document.querySelectorAll('#fineTable .fine-row'));
      const emptyRow = document.getElementById('fineSearchEmpty');
      const issueSelect = document.getElementById('issueSelect');
      const amountInput = document.getElementById('fineAmountInput');

      // Auto-suggest fine amount when selecting an issue in modal
      if (issueSelect && amountInput) {
        issueSelect.addEventListener('change', function () {
          const selectedOpt = issueSelect.options[issueSelect.selectedIndex];
          if (selectedOpt) {
            const est = parseInt(selectedOpt.dataset.est, 10);
            if (est && est > 0) {
              amountInput.value = est;
            } else {
              amountInput.value = 10;
            }
          }
        });
      }

      if (!searchInput || rows.length === 0) return;

      function debounce(fn, delay) {
        let timer = null;
        return function () {
          clearTimeout(timer);
          timer = setTimeout(() => fn.apply(this, arguments), delay);
        };
      }

      function filterFines() {
        const query = searchInput.value.trim().toLowerCase();
        const selectedStatus = statusFilter ? statusFilter.value : '';
        const selectedReturn = returnFilter ? returnFilter.value : '';
        let visibleCount = 0;

        for (let i = 0; i < rows.length; i++) {
          const row = rows[i];
          const id = row.dataset.id || '';
          const member = row.dataset.member || '';
          const book = row.dataset.book || '';
          const isbn = row.dataset.isbn || '';
          const phone = row.dataset.phone || '';
          const email = row.dataset.email || '';
          const status = row.dataset.status || '';
          const returned = row.dataset.returned || '';

          const matchesQuery = !query ||
            id.includes(query) ||
            member.includes(query) ||
            book.includes(query) ||
            isbn.includes(query) ||
            phone.includes(query) ||
            email.includes(query);

          const matchesStatus = !selectedStatus || status === selectedStatus;
          const matchesReturn = !selectedReturn || returned === selectedReturn;

          const isVisible = matchesQuery && matchesStatus && matchesReturn;
          row.classList.toggle('d-none', !isVisible);
          if (isVisible) visibleCount++;
        }

        if (emptyRow) {
          emptyRow.classList.toggle('d-none', visibleCount > 0);
        }
      }

      searchInput.addEventListener('input', debounce(filterFines, 150));
      if (statusFilter) statusFilter.addEventListener('change', filterFines);
      if (returnFilter) returnFilter.addEventListener('change', filterFines);

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          searchInput.value = '';
          if (statusFilter) statusFilter.value = '';
          if (returnFilter) returnFilter.value = '';
          filterFines();
        });
      }
    })();
  </script>
</div>
