<% layout('/layout/boilerplate') %>
<div class="books-page container py-4 py-lg-5">
  <!-- Page heading -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1">Book Catalog</h1>
      <p class="text-secondary mb-0">
        Browse the books available in the library.
      </p>
    </div>
    <span class="badge rounded-pill text-bg-light border px-3 py-2">
      <%= books.length %> books
    </span>
  </div>

  <!-- Responsive table -->
  <div class="table-responsive border rounded-3 shadow-sm">
    <table class="table table-hover table-striped align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col" class="ps-3 text-secondary small">S.No.</th>
          <th scope="col">Book Name</th>
          <th scope="col">Author</th>
          <th scope="col">ISBN</th>
          <th scope="col">Publisher</th>
          <th scope="col" class="text-center">Available Copies</th>
          <th scope="col" class="pe-3">Category</th>
          <th scope="col" class="text-center">Click to View</th>
        </tr>
      </thead>
      <tbody>
        <% if (books.length > 0) { %>
          <% books.forEach((book, index) => { %>
            <tr>
              <td class="ps-3 text-secondary small"><%= index + 1 %></td>
              <td class="fw-semibold"><%= book.title %></td>
              <td><%= book.author %></td>
              <td class="font-monospace small text-secondary text-nowrap"><%= book.isbn %></td>
              <td><%= book.publisher || '—' %></td>
              <td class="text-center">
                <% if (Number(book.available_copies) > 0) { %>
                  <span class="badge rounded-pill text-bg-success"><%= book.available_copies %></span>
                <% } else { %>
                  <span class="badge rounded-pill text-bg-danger">0</span>
                <% } %>
              </td>
              <td class="pe-3"><span class="badge rounded-pill text-bg-light border text-dark fw-normal"><%= book.category_name %></span></td>
              <td class="text-center"><a href="/books/<%=book.book_id%>">Click Here</a></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-5">
              <div class="fw-semibold mb-1">No books found</div>
              <div class="text-secondary small">The catalog is currently empty.</div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>