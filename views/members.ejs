<% layout('/layout/boilerplate') %>
<div class="members-page container py-4 py-lg-5">

  <!-- Page heading -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1">Members</h1>
      <p class="text-secondary mb-0">
        Students and faculty registered with the library.
      </p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge rounded-pill text-bg-light border px-3 py-2">
        <%= members.length %> members
      </span>
      <a href="/members/new" class="btn btn-success btn-sm px-3">
        <span aria-hidden="true">+</span></a>
    </div>
  </div>

  <%
    const maxLoansFor = (type) => (type === 'faculty' ? 5 : 3);
  %>

  <!-- Responsive table -->
  <div class="table-responsive border rounded-3 shadow-sm">
    <table class="table table-hover table-striped align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col" class="ps-3 text-secondary small text-center">S.No.</th>
          <th scope="col">Name</th>
          <th scope="col">Email</th>
          <th scope="col" class="text-center">Phone</th>
          <th scope="col" class="text-center">Type</th>
          <th scope="col" class="text-center">Status</th>
          <th scope="col" class="text-center">Active Loans</th>
          <th scope="col" class="pe-3 text-center">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (members.length > 0) { %>
          <% members.forEach((member, index) => { %>
            <%
              const max = maxLoansFor(member.member_type);
              const active = Number(member.active_loans) || 0;
              const isActive = member.status === 'active';
            %>
            <tr>
              <td class="ps-3 text-center text-secondary small"><%= index + 1 %></td>

              <td class="fw-semibold"><%= member.name %></td>

              <td><%= member.email || '—' %></td>

              <td class="font-monospace small text-nowrap text-secondary text-center">
                <%= member.phone || '—' %>
              </td>

              <td class="text-center">
                <span class="badge rounded-pill text-bg-light border text-dark fw-normal text-capitalize">
                  <%= member.member_type %>
                </span>
              </td>

              <td class="text-center">
                <span
                  class="d-inline-block rounded-circle align-middle <%= isActive ? 'bg-success' : 'bg-danger' %>"
                  style="width:10px;height:10px;"
                  title="<%= isActive ? 'Active' : 'Suspended' %>"
                ></span>
                <span class="visually-hidden"><%= isActive ? 'Active' : 'Suspended' %></span>
              </td>

              <td class="text-center">
                <span class="badge rounded-pill <%= active >= max ? 'text-bg-warning' : 'text-bg-light border text-dark' %> fw-normal">
                  <%= active %> / <%= max %>
                </span>
              </td>

              <td class="pe-3 text-center">
                <a href="/members/<%= member.member_id %>">
                    <button class="btn btn-outline-secondary">View</button>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center py-5">
              <div class="fw-semibold mb-1">No members found</div>
              <div class="text-secondary small">No members have been registered yet.</div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Status legend -->
  <div class="d-flex flex-wrap gap-3 mt-3 small text-secondary">
    <span>
      <span class="d-inline-block rounded-circle bg-success align-middle" style="width:10px;height:10px;"></span>
      Active
    </span>
    <span>
      <span class="d-inline-block rounded-circle bg-danger align-middle" style="width:10px;height:10px;"></span>
      Suspended
    </span>
  </div>
</div>