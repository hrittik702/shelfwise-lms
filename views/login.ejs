<% layout('layout/boilerplate.ejs') %>
<div class="login">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-xl-4 col-lg-5 col-md-7 col-sm-9 col-12">
        <div class="auth-card">
          <div class="text-center mb-4">
            <div class="auth-brand-badge">
              <i class="bi bi-person-fill-lock"></i>
            </div>
            <h2 class="auth-title">Welcome back</h2>
            <p class="auth-subtitle">
              Log in to your ShelfWise account to manage library circulation.
            </p>
          </div>

          <!-- Login Form -->
          <form action="/login" method="POST" class="needs-validation" novalidate>
            <!-- Username Input -->
            <div class="mb-3">
              <label for="username" class="auth-form-label">Username</label>
              <div class="input-group has-validation">
                <span class="input-group-text border-end-0 bg-transparent text-secondary">
                  <i class="bi bi-person"></i>
                </span>
                <input
                  type="text"
                  class="form-control border-start-0 ps-0"
                  name="username"
                  id="username"
                  placeholder="Enter your username"
                  autocomplete="username"
                  required
                />
                <div class="invalid-feedback">Please enter your username.</div>
              </div>
            </div>

            <!-- Password Input -->
            <div class="mb-4">
              <label for="password" class="auth-form-label">Password</label>
              <div class="input-group has-validation">
                <span class="input-group-text border-end-0 bg-transparent text-secondary">
                  <i class="bi bi-lock"></i>
                </span>
                <input
                  type="password"
                  class="form-control border-start-0 border-end-0 px-0"
                  id="password"
                  name="password"
                  placeholder="Enter your password"
                  autocomplete="current-password"
                  required
                />
                <button
                  class="btn auth-toggle-btn border-start-0"
                  type="button"
                  id="togglePassword"
                  title="Show or hide password"
                  aria-label="Toggle password visibility"
                >
                  <i class="bi bi-eye"></i>
                </button>
                <div class="invalid-feedback">Please enter your password.</div>
              </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-brand w-100 py-3 fw-bold rounded-3">
              <span>Log In</span>
              <i class="bi bi-arrow-right ms-2"></i>
            </button>
          </form>

          <div class="text-center mt-4 pt-2 border-top" style="border-color: var(--sw-border) !important;">
            <p class="text-secondary small mb-0">
              Need a staff account?
              <a href="/signup" class="text-decoration-none fw-semibold" style="color: var(--sw-emerald);">Sign Up</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Password visibility toggle
 
</script>
