<% layout('layout/boilerplate.ejs') %>
<div class="login">
  <div class="row justify-content-center">
    <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 col-12">
      <div class="auth-card">
        <div class="text-center mb-4">
          <h2 class="auth-title">Welcome back</h2>
          <p class="auth-subtitle">
            Log in to your ShelfWise account to manage your books and issue.
          </p>
        </div>

        <!-- Login Form -->
        <form action="/login" method="POST" class="needs-validation" novalidate>
          <!-- Username Input -->
          <div class="mb-3">
            <label for="username" class="auth-form-label">
              <span>Username</span>
            </label>
            <div class="input-group">
              <span class="input-group-text border-end-0">
                <i class="bi bi-person"></i>
              </span>
              <input
                type="text"
                class="form-control auth-form-control border-start-0 ps-0"
                name="username"
                id="username"
                placeholder="Enter your username"
                autocomplete="username"
                required
              />
              <div class="invalid-feedback">Please enter your username.</div>
            </div>
          </div>

          <!-- Password Input -->
          <div class="mb-3">
            <div class="input-group auth-input-group">
              <span class="input-group-text border-end-0">
                <i class="bi bi-lock"></i>
              </span>
              <input
                type="password"
                class="form-control auth-form-control border-start-0 border-end-0 px-0"
                id="password"
                name="password"
                placeholder="Enter your password"
                autocomplete="current-password"
                required
              />
              <button
                class="btn auth-toggle-btn"
                type="button"
                id="togglePassword"
                title="Show or hide password"
              >
                <i class="bi bi-eye"></i>
              </button>
              <div class="invalid-feedback">Please enter your password.</div>
            </div>
          </div>
          <!-- Submit Button -->
          <button type="submit" class="btn btn-brand w-100 py-3 fw-bold auth-submit-btn">
            <span>Log In</span>
            <i class="bi bi-arrow-right ms-2"></i>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
