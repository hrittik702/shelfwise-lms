<% layout("/layout/boilerplate") %>

<div class="shelfwise-hub container py-4 py-lg-5">
  <!-- Dashboard heading -->
  <section class="hub-hero mb-4 mb-lg-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
      <div class="d-flex align-items-center gap-3">
        <img src="/assets/logo.png" alt="ShelfWise" width="68" height="68" class="hub-logo" />

        <div>
          <p class="hub-eyebrow mb-1">LIBRARY WORKSPACE</p>
          <h1 class="h2 fw-bold mb-1">Library Operations</h1>
          <p class="text-secondary mb-0">
            Manage books, members, circulation, and fines from one place.
          </p>
        </div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a href="/books" class="btn btn-outline-success">
          <i class="bi bi-search me-2" aria-hidden="true"></i>
          Browse Catalog
        </a>

        <a href="/books/new" class="btn btn-success">
          <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>
          Add Book
        </a>
      </div>
    </div>
  </section>

  <!-- Stat Tiles (All clickable shortcuts to filtered lists) -->
  <%
    const hasStats = typeof stats === 'object' && stats !== null;
    const totalBooks = hasStats && stats.total_books !== undefined ? stats.total_books : '—';
    const booksOnLoan = hasStats && stats.books_on_loan !== undefined ? stats.books_on_loan : '—';
    const overdueLoans = hasStats && stats.overdue_loans !== undefined ? stats.overdue_loans : '—';
    const unpaidFines = hasStats && stats.unpaid_fines_amount !== undefined ? '₹' + stats.unpaid_fines_amount : '—';
  %>
  <section class="mb-4 mb-lg-5" aria-label="Library Overview Statistics">
    <div class="row g-3">
      <!-- Total Books -->
      <div class="col-6 col-lg-3">
        <a href="/books" class="hub-action-card h-100 text-decoration-none">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-secondary small fw-medium">Total Books</span>
            <div class="hub-action-icon mb-0" style="width:2.25rem;height:2.25rem;font-size:1.1rem;">
              <i class="bi bi-book" aria-hidden="true"></i>
            </div>
          </div>
          <div class="display-6 fw-bold mb-1 text-dark"><%= totalBooks %></div>
          <span class="hub-card-link small">View catalog &rarr;</span>
        </a>
      </div>

      <!-- Books on Loan -->
      <div class="col-6 col-lg-3">
        <a href="/circulation" class="hub-action-card h-100 text-decoration-none">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-secondary small fw-medium">Books on Loan</span>
            <div class="hub-action-icon mb-0" style="width:2.25rem;height:2.25rem;font-size:1.1rem;">
              <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
            </div>
          </div>
          <div class="display-6 fw-bold mb-1 text-dark"><%= booksOnLoan %></div>
          <span class="hub-card-link small">View active loans &rarr;</span>
        </a>
      </div>

      <!-- Overdue Loans -->
      <div class="col-6 col-lg-3">
        <a href="/circulation/overdue" class="hub-action-card h-100 text-decoration-none border-warning-subtle">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-secondary small fw-medium">Overdue Loans</span>
            <div class="hub-action-icon hub-action-icon-gold mb-0" style="width:2.25rem;height:2.25rem;font-size:1.1rem;">
              <i class="bi bi-clock-history" aria-hidden="true"></i>
            </div>
          </div>
          <div class="display-6 fw-bold mb-1 <%= Number(overdueLoans) > 0 ? 'text-danger' : 'text-dark' %>"><%= overdueLoans %></div>
          <span class="hub-card-link text-warning-emphasis small">Review overdue &rarr;</span>
        </a>
      </div>

      <!-- Unpaid Fines -->
      <div class="col-6 col-lg-3">
        <a href="/circulation/fines" class="hub-action-card h-100 text-decoration-none border-danger-subtle">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-secondary small fw-medium">Unpaid Fines</span>
            <div class="hub-action-icon mb-0" style="width:2.25rem;height:2.25rem;font-size:1.1rem;background-color:rgba(185,67,67,0.12);color:var(--sw-danger);">
              <i class="bi bi-cash-stack" aria-hidden="true"></i>
            </div>
          </div>
          <div class="display-6 fw-bold mb-1 text-danger"><%= unpaidFines %></div>
          <span class="hub-card-link text-danger small">Manage dues &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Actions Row -->
  <section class="mb-4 mb-lg-5" aria-labelledby="quickActionsHeading">
    <div class="hub-section-heading mb-3">
      <div>
        <h2 id="quickActionsHeading" class="h5 fw-bold mb-1">Quick Actions</h2>
        <p class="text-secondary small mb-0">Shortcuts for primary desk operations.</p>
      </div>
    </div>

    <div class="row g-3">
      <!-- Issue book -->
      <div class="col-12 col-sm-6 col-xl-3">
        <a href="/circulation/issue" class="hub-action-card h-100">
          <div class="hub-action-icon">
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
          </div>
          <h3 class="h6 fw-bold mb-1">Issue a Book</h3>
          <p class="small text-secondary mb-3">Register a new loan for an eligible member.</p>
          <span class="hub-card-link">
            Start issuing <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
          </span>
        </a>
      </div>

      <!-- Return book -->
      <div class="col-12 col-sm-6 col-xl-3">
        <a href="/circulation/return" class="hub-action-card h-100">
          <div class="hub-action-icon">
            <i class="bi bi-box-arrow-in-down-left" aria-hidden="true"></i>
          </div>
          <h3 class="h6 fw-bold mb-1">Return a Book</h3>
          <p class="small text-secondary mb-3">Process returns and calculate overdue fines.</p>
          <span class="hub-card-link">
            Open return desk <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
          </span>
        </a>
      </div>

      <!-- Register Member -->
      <div class="col-12 col-sm-6 col-xl-3">
        <a href="/members/new" class="hub-action-card h-100">
          <div class="hub-action-icon">
            <i class="bi bi-person-plus" aria-hidden="true"></i>
          </div>
          <h3 class="h6 fw-bold mb-1">Add Member</h3>
          <p class="small text-secondary mb-3">Register a new student or faculty account.</p>
          <span class="hub-card-link">
            Register member <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
          </span>
        </a>
      </div>

      <!-- Add Book -->
      <div class="col-12 col-sm-6 col-xl-3">
        <a href="/books/new" class="hub-action-card h-100">
          <div class="hub-action-icon">
            <i class="bi bi-plus-square" aria-hidden="true"></i>
          </div>
          <h3 class="h6 fw-bold mb-1">Add Book</h3>
          <p class="small text-secondary mb-3">Add a new book title to the library catalog.</p>
          <span class="hub-card-link">
            Add to catalog <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Needs Attention Row (Top overdue loans) -->
  <%
    const attentionList = Array.isArray(locals.attention) ? locals.attention : (typeof attention !== 'undefined' && Array.isArray(attention) ? attention : []);
  %>
  <section class="mb-4 mb-lg-5" aria-labelledby="needsAttentionHeading">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <h2 id="needsAttentionHeading" class="h6 fw-bold mb-0 text-danger d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            Needs Attention: Most Overdue Loans
          </h2>
        </div>
        <a href="/circulation/overdue" class="btn btn-outline-danger btn-sm">
          View All Overdue (<%= overdueLoans %>)
        </a>
      </div>

      <div class="card-body p-0">
        <% if (attentionList.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="ps-3 text-secondary small">Book</th>
                  <th scope="col" class="text-secondary small">Borrower</th>
                  <th scope="col" class="text-center text-secondary small">Overdue</th>
                  <th scope="col" class="text-end pe-3 text-secondary small">Action</th>
                </tr>
              </thead>
              <tbody>
                <% attentionList.forEach((item) => { %>
                  <tr>
                    <td class="ps-3 fw-semibold text-truncate" style="max-width: 280px;">
                      <%= item.title %>
                    </td>
                    <td>
                      <span class="text-secondary"><%= item.member_name %></span>
                    </td>
                    <td class="text-center">
                      <span class="badge rounded-pill text-bg-danger">
                        <%= item.days_overdue %> days overdue
                      </span>
                    </td>
                    <td class="text-end pe-3">
                      <a href="/circulation/return?issue_id=<%= item.issue_id %>" class="btn btn-sm btn-outline-success">
                        Return Book
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-4 text-center text-secondary">
            <i class="bi bi-check-circle-fill text-success fs-3 d-block mb-2" aria-hidden="true"></i>
            <span class="fw-semibold text-dark">Nothing overdue!</span>
            <div class="small">All borrowed books are currently on schedule.</div>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Management Navigation Sections (All valid routes) -->
  <section class="mb-4" aria-labelledby="mgmtHeading">
    <div class="hub-section-heading mb-3">
      <div>
        <h2 id="mgmtHeading" class="h5 fw-bold mb-1">Manage Your Library</h2>
        <p class="text-secondary small mb-0">Direct access to inventory, users, and circulation.</p>
      </div>
    </div>

    <div class="row g-4">
      <!-- Catalog Management -->
      <div class="col-12 col-lg-4">
        <div class="hub-management-panel h-100">
          <div class="hub-panel-heading">
            <div class="hub-action-icon mb-0">
              <i class="bi bi-collection" aria-hidden="true"></i>
            </div>
            <div>
              <h3 class="h6 fw-bold mb-0">Catalog &amp; Inventory</h3>
              <p class="small text-secondary mb-0">Book records and stock counts.</p>
            </div>
          </div>

          <div class="hub-link-list">
            <a href="/books" class="hub-list-link">
              <span><i class="bi bi-search me-2" aria-hidden="true"></i>Browse &amp; Search Books</span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a href="/books/new" class="hub-list-link">
              <span><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add New Book</span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Member Management -->
      <div class="col-12 col-lg-4">
        <div class="hub-management-panel h-100">
          <div class="hub-panel-heading">
            <div class="hub-action-icon mb-0">
              <i class="bi bi-people" aria-hidden="true"></i>
            </div>
            <div>
              <h3 class="h6 fw-bold mb-0">Member Directory</h3>
              <p class="small text-secondary mb-0">Student and faculty records.</p>
            </div>
          </div>

          <div class="hub-link-list">
            <a href="/members" class="hub-list-link">
              <span><i class="bi bi-person-lines-fill me-2" aria-hidden="true"></i>View All Members</span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a href="/members/new" class="hub-list-link">
              <span><i class="bi bi-person-plus me-2" aria-hidden="true"></i>Register New Member</span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Circulation & Finance -->
      <div class="col-12 col-lg-4">
        <div class="hub-management-panel h-100">
          <div class="hub-panel-heading">
            <div class="hub-action-icon hub-action-icon-gold mb-0">
              <i class="bi bi-wallet2" aria-hidden="true"></i>
            </div>
            <div>
              <h3 class="h6 fw-bold mb-0">Circulation &amp; Fines</h3>
              <p class="small text-secondary mb-0">Lending desk, overdue logs, and fees.</p>
            </div>
          </div>

          <div class="hub-link-list">
            <a href="/circulation" class="hub-list-link">
              <span><i class="bi bi-arrow-left-right me-2" aria-hidden="true"></i>Current Loans</span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a href="/circulation/return" class="hub-list-link">
              <span><i class="bi bi-box-arrow-in-down-left me-2" aria-hidden="true"></i>Return Desk</span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a href="/circulation/overdue" class="hub-list-link">
              <span><i class="bi bi-clock-history me-2" aria-hidden="true"></i>Overdue Tracking</span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
            <a href="/circulation/fines" class="hub-list-link">
              <span><i class="bi bi-receipt me-2" aria-hidden="true"></i>Fine Records</span>
              <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
