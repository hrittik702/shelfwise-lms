<% layout('/layout/boilerplate') %>

<div class="container py-4 py-lg-5">

  <%
    const fmt = (d) => d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
    const today = new Date();
    const due = new Date();
    due.setDate(due.getDate() + 14);

    const maxLoansFor = (type) => (type === 'faculty' ? 5 : 3);
    const preMember = String(typeof selectedMemberId !== 'undefined' && selectedMemberId ? selectedMemberId : '');
    const preBook = String(typeof selectedBookId !== 'undefined' && selectedBookId ? selectedBookId : '');
    const staffName = (typeof currUser !== 'undefined' && currUser) ? currUser.name : '—';
  %>

  <!-- Back navigation -->
  <div class="mb-4">
    <a href="/" class="btn btn-outline-secondary btn-sm">
      <span aria-hidden="true">&larr;</span> Back to Home
    </a>
  </div>

  <!-- Heading -->
  <div class="mb-4">
    <h1 class="h3 fw-bold mb-1">Issue Book</h1>
    <p class="text-secondary mb-0">Select a member and a book, then review the loan before confirming.</p>
  </div>

  <% if (members.length === 0 || books.length === 0) { %>
    <div class="alert alert-warning">
      <% if (members.length === 0) { %>
        No members are registered yet. <a href="/members/new">Register a member</a> first.
      <% } else { %>
        No books are in the catalog yet. <a href="/books/new">Add a book</a> first.
      <% } %>
    </div>
  <% } else { %>

  <form action="/circulation/issue" method="POST" id="issueForm">
    <div class="row g-4">

      <!-- LEFT: selection -->
      <div class="col-12 col-lg-8">

        <!-- Step 1: Member -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
          <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h6 fw-bold mb-0">
              <span class="badge rounded-pill text-bg-success me-2">1</span>Select Member
            </h2>
            <input type="search" id="memberSearch" class="form-control form-control-sm" style="max-width:240px;"
                   placeholder="Search name or type" aria-label="Search members">
          </div>

          <div class="list-group list-group-flush overflow-auto" style="max-height:300px;" id="memberList">
            <% members.forEach((m) => {
              const max = maxLoansFor(m.member_type);
              const active = Number(m.active_loans) || 0;
              const suspended = m.status !== 'active';
              const atLimit = active >= max;
              const blocked = suspended || atLimit;
              const pct = Math.min(100, Math.round((active / max) * 100));
            %>
              <label class="list-group-item d-flex align-items-center gap-3 sw-row <%= blocked ? 'opacity-50' : '' %>"
                     data-search="<%= (m.name + ' ' + m.member_type).toLowerCase() %>"
                     style="cursor:<%= blocked ? 'not-allowed' : 'pointer' %>;">
                <input class="form-check-input mt-0 flex-shrink-0" type="radio" name="member_id"
                       value="<%= m.member_id %>"
                       data-name="<%= m.name %>"
                       data-type="<%= m.member_type %>"
                       data-active="<%= active %>"
                       data-max="<%= max %>"
                       <%= preMember === String(m.member_id) && !blocked ? 'checked' : '' %>
                       <%= blocked ? 'disabled' : '' %> required>

                <div class="flex-grow-1">
                  <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-semibold"><%= m.name %></span>
                    <span class="badge rounded-pill text-bg-light border text-dark fw-normal text-capitalize"><%= m.member_type %></span>
                    <% if (suspended) { %>
                      <span class="badge rounded-pill text-bg-danger">Suspended</span>
                    <% } else if (atLimit) { %>
                      <span class="badge rounded-pill text-bg-warning">Limit reached</span>
                    <% } %>
                  </div>
                  <div class="d-flex align-items-center gap-2 mt-1">
                    <div class="progress flex-grow-1" style="height:6px;max-width:160px;" role="progressbar"
                         aria-valuenow="<%= active %>" aria-valuemin="0" aria-valuemax="<%= max %>">
                      <div class="progress-bar <%= atLimit ? 'bg-warning' : 'bg-success' %>" style="width:<%= pct %>%"></div>
                    </div>
                    <span class="small text-secondary"><%= active %> of <%= max %> loans used</span>
                  </div>
                </div>
              </label>
            <% }) %>
            <div class="list-group-item text-center text-secondary small d-none" id="memberEmpty">No members match your search.</div>
          </div>
        </div>

        <!-- Step 2: Book -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
          <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h6 fw-bold mb-0">
              <span class="badge rounded-pill text-bg-success me-2">2</span>Select Book
            </h2>
            <input type="search" id="bookSearch" class="form-control form-control-sm" style="max-width:240px;"
                   placeholder="Search title or ISBN" aria-label="Search books">
          </div>

          <div class="list-group list-group-flush overflow-auto" style="max-height:300px;" id="bookList">
            <% books.forEach((b) => {
              const available = Number(b.available_copies) || 0;
              const total = Number(b.total_copies) || 0;
              const out = available <= 0;
              const pct = total > 0 ? Math.round((available / total) * 100) : 0;
            %>
              <label class="list-group-item d-flex align-items-center gap-3 sw-row <%= out ? 'opacity-50' : '' %>"
                     data-search="<%= (b.title + ' ' + b.isbn).toLowerCase() %>"
                     style="cursor:<%= out ? 'not-allowed' : 'pointer' %>;">
                <input class="form-check-input mt-0 flex-shrink-0" type="radio" name="book_id"
                       value="<%= b.book_id %>"
                       data-title="<%= b.title %>"
                       data-isbn="<%= b.isbn %>"
                       data-available="<%= available %>"
                       data-total="<%= total %>"
                       <%= preBook === String(b.book_id) && !out ? 'checked' : '' %>
                       <%= out ? 'disabled' : '' %> required>

                <div class="flex-grow-1">
                  <div class="fw-semibold"><%= b.title %></div>
                  <div class="small text-secondary font-monospace"><%= b.isbn %></div>
                  <div class="d-flex align-items-center gap-2 mt-1">
                    <div class="progress flex-grow-1" style="height:6px;max-width:160px;" role="progressbar"
                         aria-valuenow="<%= available %>" aria-valuemin="0" aria-valuemax="<%= total %>">
                      <div class="progress-bar <%= out ? 'bg-danger' : (pct <= 25 ? 'bg-warning' : 'bg-success') %>" style="width:<%= pct %>%"></div>
                    </div>
                    <span class="small text-secondary"><%= out ? 'None available' : available + ' of ' + total + ' available' %></span>
                  </div>
                </div>
              </label>
            <% }) %>
            <div class="list-group-item text-center text-secondary small d-none" id="bookEmpty">No books match your search.</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: loan summary -->
      <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-sticky" style="top:1rem;">
          <div class="card-header bg-white border-bottom p-3">
            <h2 class="h6 fw-bold mb-0">Loan Summary</h2>
          </div>

          <div class="card-body p-3">
            <dl class="mb-3 small">
              <dt class="text-secondary fw-normal">Member</dt>
              <dd class="fw-semibold mb-2" id="sumMember"><span class="text-secondary fw-normal">Not selected</span></dd>

              <dt class="text-secondary fw-normal">Loans after this issue</dt>
              <dd class="fw-semibold mb-2" id="sumLoans">—</dd>

              <dt class="text-secondary fw-normal">Book</dt>
              <dd class="fw-semibold mb-2" id="sumBook"><span class="text-secondary fw-normal">Not selected</span></dd>

              <dt class="text-secondary fw-normal">Copies left after this issue</dt>
              <dd class="fw-semibold mb-0" id="sumCopies">—</dd>
            </dl>

            <div class="border rounded-3 p-3 mb-3 bg-light small">
              <div class="d-flex justify-content-between"><span class="text-secondary">Issue date</span><span class="fw-semibold"><%= fmt(today) %></span></div>
              <div class="d-flex justify-content-between"><span class="text-secondary">Due date</span><span class="fw-semibold"><%= fmt(due) %></span></div>
              <div class="d-flex justify-content-between"><span class="text-secondary">Issued by</span><span class="fw-semibold"><%= staffName %></span></div>
            </div>

            <ul class="small text-secondary ps-3 mb-3">
              <li>Loan period is 14 days.</li>
              <li>Fine: ₹2 per day after the due date.</li>
              <li>Dates and staff are set by the server.</li>
            </ul>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-success" id="issueBtn" disabled>Confirm &amp; Issue Book</button>
              <a href="/" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </form>

  <script>
    (function () {
      const form = document.getElementById('issueForm');
      const btn = document.getElementById('issueBtn');
      const sumMember = document.getElementById('sumMember');
      const sumLoans = document.getElementById('sumLoans');
      const sumBook = document.getElementById('sumBook');
      const sumCopies = document.getElementById('sumCopies');

      function setText(el, text) { el.textContent = text; }

      function update() {
        const m = form.querySelector('input[name="member_id"]:checked');
        const b = form.querySelector('input[name="book_id"]:checked');

        form.querySelectorAll('.sw-row').forEach(function (row) {
          const r = row.querySelector('input');
          row.classList.toggle('bg-success-subtle', r.checked);
        });

        if (m) {
          const after = Number(m.dataset.active) + 1;
          setText(sumMember, m.dataset.name + ' (' + m.dataset.type + ')');
          setText(sumLoans, after + ' of ' + m.dataset.max);
        } else {
          setText(sumMember, 'Not selected');
          setText(sumLoans, '—');
        }

        if (b) {
          const left = Number(b.dataset.available) - 1;
          setText(sumBook, b.dataset.title);
          setText(sumCopies, left + ' of ' + b.dataset.total);
        } else {
          setText(sumBook, 'Not selected');
          setText(sumCopies, '—');
        }

        btn.disabled = !(m && b);
      }

      function bindSearch(inputId, listId, emptyId) {
        const input = document.getElementById(inputId);
        const rows = document.querySelectorAll('#' + listId + ' .sw-row');
        const empty = document.getElementById(emptyId);
        input.addEventListener('input', function () {
          const q = input.value.trim().toLowerCase();
          let shown = 0;
          rows.forEach(function (row) {
            const match = !q || row.dataset.search.indexOf(q) !== -1;
            row.classList.toggle('d-none', !match);
            if (match) shown++;
          });
          empty.classList.toggle('d-none', shown !== 0);
        });
      }

      bindSearch('memberSearch', 'memberList', 'memberEmpty');
      bindSearch('bookSearch', 'bookList', 'bookEmpty');

      form.addEventListener('change', update);

      // prevent double submit
      form.addEventListener('submit', function () {
        btn.disabled = true;
        btn.textContent = 'Issuing...';
      });

      update();
    })();
  </script>

  <% } %>
</div>