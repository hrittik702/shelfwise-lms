<% layout('/layout/boilerplate') %>

<div class="member-detail-page container py-4 py-lg-5">
  <% const fmt = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day:
  '2-digit', month: 'short', year: 'numeric' }) : '—'; const maxLoans =
  member.member_type === 'faculty' ? 5 : 3; const active =
  Number(member.active_loans) || 0; const totalIssues =
  Number(member.total_issues) || 0; const unpaid = Number(member.unpaid_fines)
  || 0; const isActive = member.status === 'active'; const isAtLimit = active >=
  maxLoans; const canDelete = active === 0 && unpaid === 0; const loans =
  (typeof activeLoans !== 'undefined' && Array.isArray(activeLoans)) ?
  activeLoans : []; %>

  <!-- Back navigation -->
  <div class="mb-4">
    <a href="/members" class="members-back-link">
      <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
      <span>Back to Members</span>
    </a>
  </div>

  <!-- Header & Actions -->
  <div
    class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 mb-4"
  >
    <div>
      <h1 class="members-title h3 fw-bold mb-1"><%= member.name %></h1>
    </div>

    <div class="d-flex align-items-center gap-2 flex-shrink-0">
      <a
        href="/members/<%= member.member_id %>/update"
        class="members-btn-secondary"
      >
        <i class="bi bi-pencil me-1" aria-hidden="true"></i>
        <span>Edit Member</span>
      </a>
      <% if (isActive && !isAtLimit) { %>
      <a
        href="/circulation/issue?member_id=<%= member.member_id %>"
        class="members-btn-primary btn-sm"
      >
        <i
          class="bi bi-journal-plus members-btn-icon-gold me-1"
          aria-hidden="true"
        ></i>
        <span>Issue Book</span>
      </a>
      <% } %>
    </div>
  </div>

  <div class="row g-4">
    <!-- LEFT: Main Information & Active Loans -->
    <div class="col-12 col-lg-8">
      <!-- Stats Overview -->
      <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
          <div class="members-summary-card p-3 p-md-4 h-100 bg-white">
            <div class="text-secondary small fw-medium mb-1">Active Loans</div>
            <div class="fs-2 fw-bold text-dark font-monospace">
              <%= active %>
              <span class="fs-6 text-secondary fw-normal"
                >/
                <%= maxLoans %>
                limit</span
              >
            </div>
            <% if (isAtLimit) { %>
            <div class="small text-warning-emphasis mt-1">
              <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
              Limit reached
            </div>
            <% } %>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="members-summary-card p-3 p-md-4 h-100 bg-white">
            <div class="text-secondary small fw-medium mb-1">
              Lifetime Borrowings
            </div>
            <div class="fs-2 fw-bold text-dark font-monospace">
              <%= totalIssues %>
            </div>
            <div class="small text-secondary mt-1">Total loans issued</div>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div
            class="members-summary-card p-3 p-md-4 h-100 bg-white <%= unpaid > 0 ? 'members-card-suspended' : '' %>"
          >
            <div class="text-secondary small fw-medium mb-1">
              Outstanding Fines
            </div>
            <div
              class="fs-2 fw-bold font-monospace <%= unpaid > 0 ? 'text-danger' : 'text-success' %>"
            >
              <%= unpaid > 0 ? '₹' + unpaid : '₹0' %>
            </div>
            <div
              class="small <%= unpaid > 0 ? 'text-danger' : 'text-secondary' %> mt-1"
            >
              <%= unpaid > 0 ? 'Dues pending payment' : 'No overdue fines' %>
            </div>
          </div>
        </div>
      </div>

      <!-- Current Active Loans Table -->
      <div
        class="card members-card mb-4 shadow-sm border-0 rounded-4 overflow-hidden bg-white"
      >
        <div
          class="card-header bg-white border-bottom p-3 p-md-4 d-flex justify-content-between align-items-center"
        >
          <div>
            <h2 class="h5 fw-bold mb-0 text-dark">Currently Borrowed Books</h2>
            <p class="text-secondary small mb-0">
              Active loans awaiting return
            </p>
          </div>
          <span class="badge rounded-pill bg-light text-dark border">
            <%= loans.length %> active
          </span>
        </div>

        <div class="card-body p-0">
          <% if (loans.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 members-table">
              <thead>
                <tr>
                  <th scope="col" class="ps-3 text-center" style="width: 44px">
                    #
                  </th>
                  <th scope="col">Book Title</th>
                  <th scope="col">ISBN</th>
                  <th scope="col" class="text-center">Issued On</th>
                  <th scope="col" class="text-center">Due Date</th>
                  <th scope="col" class="text-center">Status</th>
                  <th scope="col" class="pe-3 text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% loans.forEach((l, idx) => { const days =
                Number(l.days_overdue) || 0; %>
                <tr>
                  <td class="ps-3 text-center text-secondary small">
                    <%= idx + 1 %>
                  </td>
                  <td class="fw-semibold">
                    <a href="/books/<%= l.book_id %>" class="members-name-link">
                      <%= l.book_title %>
                    </a>
                    <% if (l.author) { %>
                    <div class="small text-secondary"><%= l.author %></div>
                    <% } %>
                  </td>
                  <td class="small text-secondary font-monospace">
                    <%= l.isbn %>
                  </td>
                  <td class="text-center small text-nowrap font-monospace">
                    <%= fmt(l.issue_date) %>
                  </td>
                  <td
                    class="text-center small text-nowrap font-monospace <%= days > 0 ? 'text-danger fw-semibold' : '' %>"
                  >
                    <%= fmt(l.due_date) %>
                  </td>
                  <td class="text-center text-nowrap">
                    <% if (days > 0) { %>
                    <span class="circ-status-badge circ-status-overdue"
                      ><%= days %>
                      day<%= days === 1 ? '' : 's' %>
                      overdue</span
                    >
                    <% } else if (days === 0) { %>
                    <span class="circ-status-badge circ-status-due-today"
                      >Due today</span
                    >
                    <% } else { %>
                    <span class="circ-status-badge circ-status-active"
                      ><%= Math.abs(days) %>
                      day<%= days === -1 ? '' : 's' %>
                      left</span
                    >
                    <% } %>
                  </td>
                  <td class="pe-3 text-end">
                    <a
                      href="/circulation/<%= l.issue_id %>/return"
                      class="btn btn-outline-secondary btn-sm"
                    >
                      Return
                    </a>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="text-center py-5 px-3">
            <i
              class="bi bi-journal-check fs-2 text-secondary mb-2 d-block"
              aria-hidden="true"
            ></i>
            <h3 class="h6 fw-bold text-dark mb-1">
              No books currently on loan
            </h3>
            <p class="text-secondary small mb-0">
              This member has returned all previous loans and has 0 active
              borrowings.
            </p>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Member Profile Details Card -->
      <div
        class="card members-card shadow-sm border-0 rounded-4 overflow-hidden bg-white"
      >
        <div class="card-header bg-white border-bottom p-3 p-md-4">
          <h2 class="h5 fw-bold mb-0 text-dark">Member Profile Details</h2>
        </div>
        <div class="card-body p-3 p-md-4">
          <dl class="row mb-0">
            <dt class="col-sm-3 text-secondary fw-normal">Full Name</dt>
            <dd class="col-sm-9 fw-semibold"><%= member.name %></dd>

            <dt class="col-sm-3 text-secondary fw-normal">Email Address</dt>
            <dd class="col-sm-9 text-break"><%= member.email || '—' %></dd>

            <dt class="col-sm-3 text-secondary fw-normal">Phone</dt>
            <dd class="col-sm-9 font-monospace"><%= member.phone || '—' %></dd>

            <dt class="col-sm-3 text-secondary fw-normal">Membership Role</dt>
            <dd class="col-sm-9 text-capitalize"><%= member.member_type %></dd>

            <dt class="col-sm-3 text-secondary fw-normal">Registration Date</dt>
            <dd class="col-sm-9 font-monospace">
              <%= fmt(member.join_date) %>
            </dd>

            <dt class="col-sm-3 text-secondary fw-normal">Status</dt>
            <dd class="col-sm-9 mb-0">
              <% if (isActive) { %>
              <span class="circ-status-badge circ-status-active">Active</span>
              <% } else { %>
              <span class="circ-status-badge circ-status-overdue"
                >Suspended</span
              >
              <% } %>
            </dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- RIGHT: Profile Sidebar & Safe Deletion -->
    <div class="col-12 col-lg-4">
      <div
        class="card members-card shadow-sm border-0 rounded-4 overflow-hidden bg-white mb-4 position-sticky"
        style="top: 1.5rem"
      >
        <div class="card-header bg-white border-bottom p-3">
          <h2 class="h6 fw-bold mb-0 text-dark">Membership Status</h2>
        </div>
        <div class="card-body p-3 p-md-4">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div
              class="members-avatar rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
            >
              <%= (member.name || 'M').charAt(0).toUpperCase() %>
            </div>
            <div class="min-w-0">
              <h3 class="h6 fw-bold text-dark mb-0 text-truncate">
                <%= member.name %>
              </h3>
            </div>
          </div>
          <div class="card-body p-3 p-md-4">
            <dl class="row mb-0">
              <dt class="col-sm-3 text-secondary fw-normal">Email Address</dt>
              <dd class="col-sm-9 text-break"><%= member.email || '—' %></dd>

              <dt class="col-sm-5 text-secondary fw-normal">Phone</dt>
              <dd class="col-sm-9 font-monospace">
                <%= member.phone || '—' %>
              </dd>

              <dt class="col-sm-3 text-secondary fw-normal">Membership Role</dt>
              <dd class="col-sm-9 text-capitalize">
                <%= member.member_type %>
              </dd>

              <dt class="col-sm-3 text-secondary fw-normal">
                Registration Date
              </dt>
              <dd class="col-sm-9 font-monospace">
                <%= fmt(member.join_date) %>
              </dd>

              <dt class="col-sm-3 text-secondary fw-normal">Status</dt>
              <dd class="col-sm-9 mb-0">
                <% if (isActive) { %>
                <span class="circ-status-badge circ-status-active">Active</span>
                <% } else { %>
                <span class="circ-status-badge circ-status-overdue"
                  >Suspended</span
                >
                <% } %>
              </dd>
            </dl>
          </div>
          <div class="p-3 bg-light rounded-3 mb-3 border">
            <div class="d-flex justify-content-between mb-1">
              <span class="text-secondary small">Account status</span>
              <span
                class="fw-semibold <%= isActive ? 'text-success' : 'text-danger' %>"
              >
                <%= isActive ? 'Active' : 'Suspended' %>
              </span>
            </div>
            <div class="d-flex justify-content-between mb-1">
              <span class="text-secondary small">Allowed limit</span>
              <span class="fw-semibold text-dark font-monospace"
                ><%= maxLoans %>
                books</span
              >
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-secondary small">Available slots</span>
              <span class="fw-bold font-monospace text-dark"
                ><%= Math.max(0, maxLoans - active) %>
                left</span
              >
            </div>
          </div>

          <!-- Danger Zone: Deletion with confirmation -->
          <div class="pt-3 border-top">
            <div class="text-secondary small mb-2">
              <i class="bi bi-shield-exclamation me-1" aria-hidden="true"></i>
              <%= canDelete ? 'This member has no active loans or pending dues and can be safely deleted.' : 'Deletion restricted: member currently has active loans or unpaid fine records.' %>
            </div>

            <% if (canDelete) { %>
            <form
              action="/members/<%= member.member_id %>/delete"
              method="POST"
              data-confirm="Are you sure you want to delete <%= member.name %>? This will permanently remove their member record."
              data-btn="Delete Member"
              data-title="Delete Member"
              data-variant="danger"
            >
              <button type="submit" class="members-btn-danger w-100">
                <i class="bi bi-trash3 me-1" aria-hidden="true"></i> Delete
                Member
              </button>
            </form>
            <% } else { %>
            <button
              type="button"
              class="members-btn-disabled w-100"
              disabled
              title="Member has active loans or dues"
            >
              <i class="bi bi-lock me-1" aria-hidden="true"></i> Delete Member
              (Restricted)
            </button>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
