<% layout('/layout/boilerplate') %>

<div class="member-form-page container py-4 py-lg-5">
  <%
    const fmt = (d) => d
      ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })
      : '—';
  %>

  <!-- Back navigation -->
  <div class="mb-4">
    <a href="/members/<%= member.member_id %>" class="members-back-link">
      <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
      <span>Back to Member Details</span>
    </a>
  </div>

  <!-- Heading -->
  <div class="mb-4">
    <h1 class="members-title h3 fw-bold mb-1">Update Member</h1>
    <p class="members-subtitle mb-0 text-secondary">
      Review and update member contact and membership information.
    </p>
  </div>

  <!-- Update Form Card -->
  <div class="card members-form-card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex justify-content-between align-items-center">
      <div>
        <h2 class="h5 fw-bold mb-1 text-dark">Edit Member Record</h2>
        <span class="text-secondary small font-monospace">Member ID: #<%= member.member_id %></span>
      </div>
      <div>
        <% if (member.status === 'active') { %>
          <span class="circ-status-badge circ-status-active">Active</span>
        <% } else { %>
          <span class="circ-status-badge circ-status-overdue">Suspended</span>
        <% } %>
      </div>
    </div>

    <div class="card-body p-3 p-md-4">
      <form
        action="/members/<%= member.member_id %>/update"
        method="POST"
        id="updateMemberForm"
        data-confirm="Are you sure you want to save the updated information for <%= member.name %>?"
        data-btn="Update Member"
        data-title="Update Member Profile"
        data-variant="success"
      >
        <!-- Personal Information -->
        <div class="members-form-section mb-4">
          <div class="members-section-label text-uppercase text-secondary small fw-bold mb-3">Personal Details</div>

          <!-- Name -->
          <div class="mb-3">
            <label for="name" class="form-label fw-semibold">
              Full Name <span class="text-danger">*</span>
            </label>
            <input
              type="text"
              class="form-control"
              id="name"
              name="name"
              value="<%= member.name %>"
              maxlength="50"
              required
            >
          </div>

          <!-- Email & Phone -->
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="email" class="form-label fw-semibold">
                Email Address <span class="text-danger">*</span>
              </label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                value="<%= member.email || '' %>"
                maxlength="100"
                required
              >
            </div>

            <div class="col-12 col-md-6">
              <label for="phone" class="form-label fw-semibold">
                Phone Number <span class="text-danger">*</span>
              </label>
              <input
                type="text"
                class="form-control font-monospace"
                id="phone"
                name="phone"
                value="<%= member.phone || '' %>"
                minlength="10"
                maxlength="10"
                pattern="[0-9]{10}"
                inputmode="numeric"
                title="Enter exactly 10 numeric digits."
                required
              >
              <div class="form-text small text-secondary">
                Exact 10 digits without country code.
              </div>
            </div>
          </div>
        </div>

        <hr class="my-4 text-muted opacity-25">

        <!-- Membership Type & Status -->
        <div class="members-form-section mb-4">
          <div class="members-section-label text-uppercase text-secondary small fw-bold mb-3">Membership &amp; Status</div>

          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="member_type" class="form-label fw-semibold">
                Role / Type <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="member_type" name="member_type" required>
                <option value="student" <%= member.member_type === 'student' ? 'selected' : '' %>>
                  Student (3 books max)
                </option>
                <option value="faculty" <%= member.member_type === 'faculty' ? 'selected' : '' %>>
                  Faculty (5 books max)
                </option>
              </select>
            </div>

            <div class="col-12 col-md-6">
              <label for="status" class="form-label fw-semibold">
                Account Status <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="status" name="status" required>
                <option value="active" <%= member.status === 'active' ? 'selected' : '' %>>
                  Active
                </option>
                <option value="suspended" <%= member.status === 'suspended' ? 'selected' : '' %>>
                  Suspended
                </option>
              </select>
              <div class="form-text small text-secondary">
                Suspended members are blocked from borrowing books until reinstated.
              </div>
            </div>
          </div>
        </div>

        <hr class="my-4 text-muted opacity-25">

        <!-- Record Information (Read Only) -->
        <div class="members-form-section mb-4">
          <div class="members-section-label text-uppercase text-secondary small fw-bold mb-3">Account Metadata</div>

          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold text-secondary">
                Member ID
              </label>
              <div class="form-control bg-light font-monospace text-dark fw-bold" aria-readonly="true">
                #<%= member.member_id %>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold text-secondary">
                Join Date
              </label>
              <div class="form-control bg-light font-monospace text-dark" aria-readonly="true">
                <%= fmt(member.join_date) %>
              </div>
              <div class="form-text small text-secondary">
                Recorded at time of registration.
              </div>
            </div>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 pt-3 border-top">
          <a href="/members/<%= member.member_id %>" class="members-btn-secondary px-4">Cancel</a>
          <button type="submit" class="members-btn-primary">
            <i class="bi bi-check2-circle members-btn-icon-gold me-1" aria-hidden="true"></i>
            <span>Update Member</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
