<% layout('/layout/boilerplate') %>

<div class="container py-4 py-lg-5">
  <!-- Back navigation -->
  <div class="mb-4">
    <a href="/members" class="btn btn-outline-secondary btn-sm">
      <span aria-hidden="true">&larr;</span>
      Back to Members
    </a>
  </div>

  <!-- Add form card -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <!-- Heading -->
    <div class="card-header bg-white border-bottom p-4">
      <h1 class="h3 fw-bold mb-2">Register Member</h1>

      <p class="text-secondary mb-0">Add a new student or faculty member to the library.</p>
    </div>

    <!-- Form -->
    <div class="card-body p-4">
      <form action="/members" method="POST">
        <!-- Name -->
        <div class="mb-4">
          <label for="name" class="form-label fw-semibold"> Full Name </label>

          <input
            type="text"
            class="form-control"
            id="name"
            name="name"
            maxlength="30"
            autocomplete="name"
            required
          />
        </div>

        <!-- Email and Phone -->
        <div class="row g-3 mb-4">
          <div class="col-12 col-md-6">
            <label for="email" class="form-label fw-semibold"> Email </label>

            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              maxlength="40"
              autocomplete="email"
              required
            />
          </div>

          <div class="col-12 col-md-6">
            <label for="phone" class="form-label fw-semibold"> Phone </label>

            <input
              type="text"
              class="form-control"
              id="phone"
              name="phone"
              minlength="10"
              maxlength="10"
              pattern="[0-9]{10}"
              inputmode="numeric"
              autocomplete="tel"
              title="Enter exactly 10 numeric digits."
              required
            />

            <div class="form-text">Enter exactly 10 digits.</div>
          </div>
        </div>

        <!-- Member type -->
        <div class="mb-4">
          <label for="member_type" class="form-label fw-semibold"> Member Type </label>

          <select class="form-select" id="member_type" name="member_type" required>
            <option value="" selected disabled>Select member type</option>
            <option value="student">Student</option>
            <option value="faculty">Faculty</option>
          </select>

          <div class="form-text">Students can hold up to 3 books at a time, faculty up to 5.</div>
        </div>

        <!-- Automatic information -->
        <div class="border rounded-3 p-3 mb-4">
          <h2 class="h6 fw-bold mb-2">Automatic Settings</h2>

          <p class="text-secondary small mb-0">
            The join date is set to today and the status starts as
            <span class="fw-semibold">Active</span> when the member is registered. Status can be
            changed later from the update page.
          </p>
        </div>

        <!-- Form actions -->
        <div class="d-flex flex-wrap justify-content-end gap-2">
          <a href="/members" class="btn btn-outline-secondary"> Cancel </a>

          <button type="submit" class="btn btn-success px-4">Register Member</button>
        </div>
      </form>
    </div>
  </div>
</div>
