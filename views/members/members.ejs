<% layout('/layout/boilerplate') %>

<div class="members-page container py-4 py-lg-5">
  <% const maxLoansFor = (type) => (type === 'faculty' ? 5 : 3); const
  totalMembers = members.length; let activeMembersCount = 0; let studentsCount =
  0; let facultyCount = 0; let suspendedCount = 0; members.forEach(m => { if
  (m.status === 'active') activeMembersCount++; else suspendedCount++; if
  (m.member_type === 'faculty') facultyCount++; else studentsCount++; }); %>

  <!-- Page Heading -->
  <div
    class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4"
  >
    <div>
      <h1 class="members-title h3 fw-bold mb-1">Library Members</h1>
      <p class="text-secondary mb-0">Manage student and faculty records.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <a href="/members/new" class="members-btn-primary">
        <i
          class="bi bi-person-plus-fill members-btn-icon-gold me-1"
          aria-hidden="true"
        ></i>
        <span>Register Member</span>
      </a>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="members-summary-card p-3 p-md-4 h-100 bg-white">
        <div class="text-secondary small fw-medium mb-1">Total Registered</div>
        <div class="fs-2 fw-bold text-dark"><%= totalMembers %></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="members-summary-card p-3 p-md-4 h-100 bg-white">
        <div class="text-secondary small fw-medium mb-1">Active Accounts</div>
        <div class="fs-2 fw-bold text-success"><%= activeMembersCount %></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="members-summary-card p-3 p-md-4 h-100 bg-white">
        <div class="text-secondary small fw-medium mb-1">
          Students &middot; Faculty
        </div>
        <div class="fs-4 fw-bold text-dark mt-1">
          <span><%= studentsCount %></span>
          <span class="text-secondary fw-normal fs-6">students &middot;</span>
          <span><%= facultyCount %></span>
          <span class="text-secondary fw-normal fs-6">faculty</span>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div
        class="members-summary-card p-3 p-md-4 h-100 bg-white <%= suspendedCount > 0 ? 'members-card-suspended' : '' %>"
      >
        <div class="text-secondary small fw-medium mb-1">
          Suspended Accounts
        </div>
        <div
          class="fs-2 fw-bold <%= suspendedCount > 0 ? 'text-danger' : 'text-secondary' %>"
        >
          <%= suspendedCount %>
        </div>
      </div>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <div class="row g-2 align-items-center">
      <div class="col-12 col-md-5">
        <div class="members-search-box">
          <i class="bi bi-search members-search-icon" aria-hidden="true"></i>
          <label for="memberDirectorySearch" class="visually-hidden"
            >Search members</label
          >
          <input
            type="search"
            id="memberDirectorySearch"
            class="form-control form-control-sm members-search-input"
            placeholder="Search by name, email, phone, or ID..."
            aria-label="Search members"
          />
        </div>
      </div>
      <div class="col-6 col-md-3">
        <label for="memberTypeFilter" class="visually-hidden"
          >Filter by type</label
        >
        <select
          id="memberTypeFilter"
          class="form-select form-select-sm"
          aria-label="Filter by type"
        >
          <option value="">All Types (Students &amp; Faculty)</option>
          <option value="student">Students</option>
          <option value="faculty">Faculty</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <label for="memberStatusFilter" class="visually-hidden"
          >Filter by status</label
        >
        <select
          id="memberStatusFilter"
          class="form-select form-select-sm"
          aria-label="Filter by status"
        >
          <option value="">All Statuses</option>
          <option value="active">Active Only</option>
          <option value="suspended">Suspended Only</option>
        </select>
      </div>
      <div class="col-12 col-md-2 text-md-end">
        <button
          type="button"
          id="resetMemberFiltersBtn"
          class="btn btn-outline-secondary btn-sm w-100"
        >
          <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>
          Reset
        </button>
      </div>
    </div>
  </div>

  <!-- Responsive Table -->
  <div
    class="table-responsive members-table-wrapper rounded-3 shadow-sm border mb-3"
  >
    <table
      class="table table-hover table-striped align-middle mb-0 members-table"
      id="membersTable"
    >
      <thead>
        <tr>
          <th scope="col" class="ps-3 text-center" style="width: 55px">
            S.No.
          </th>
          <th scope="col">Member Name</th>
          <th scope="col">Email</th>
          <th scope="col" class="text-center">Phone</th>
          <!--<th scope="col" class="text-center">Type</th>-->
          <th scope="col" class="text-center">Active Loans</th>
          <th scope="col" class="text-center">Status</th>
          <th scope="col" class="pe-3 text-center" style="width: 165px">
            Actions
          </th>
        </tr>
      </thead>
      <tbody>
        <% if (members.length > 0) { %> <% members.forEach((member, index) => {
        %>
        <%
              const max = maxLoansFor(member.member_type);
              const active = Number(member.active_loans) || 0;
              const isActive = member.status === 'active';
            %>
        <tr
          class="member-row"
          data-name="<%= (member.name || '').toLowerCase() %>"
          data-email="<%= (member.email || '').toLowerCase() %>"
          data-phone="<%= (member.phone || '').toLowerCase() %>"
          data-id="<%= member.member_id %>"
          data-type="<%= member.member_type %>"
          data-status="<%= member.status %>"
        >
          <td class="ps-3 text-center text-secondary small">
            <%= index + 1 %>
          </td>
          <td class="fw-semibold">
            <a
              href="/members/<%= member.member_id %>"
              class="members-name-link"
              title="View <%= member.name %> profile"
            >
              <%= member.name %>
            </a>
          </td>
          <td class="small text-dark text-break"><%= member.email || '—' %></td>
          <td
            class="text-center font-monospace small text-nowrap text-secondary"
          >
            <%= member.phone || '—' %>
          </td>
          <!--<td class="text-center">
            <span
              class="badge rounded-pill text-bg-light border text-dark fw-normal text-capitalize"
            >
              <%= member.member_type %>
            </span>
          </td>-->
          <td class="text-center text-nowrap">
            <span
              class="font-monospace fw-semibold <%= active >= max ? 'text-warning-emphasis' : 'text-dark' %>"
            >
              <%= active %>
            </span>
            <span class="text-secondary small">/ <%= max %></span>
          </td>
          <td class="text-center text-nowrap">
            <% if (isActive) { %>
            <span class="circ-status-badge circ-status-active">Active</span>
            <% } else { %>
            <span class="circ-status-badge circ-status-overdue">Suspended</span>
            <% } %>
          </td>
          <td class="pe-3 text-end text-nowrap">
            <div
              class="d-inline-flex align-items-center justify-content-end gap-1"
            >
              <a
                href="/members/<%= member.member_id %>"
                class="members-action-btn members-action-view"
                title="View <%= member.name %> profile"
              >
                <i class="bi bi-eye" aria-hidden="true"></i>
                <span>View</span>
              </a>
              <a
                href="/members/<%= member.member_id %>/update"
                class="members-action-btn members-action-edit"
                title="Edit <%= member.name %>"
              >
                <i class="bi bi-pencil" aria-hidden="true"></i>
                <span>Edit</span>
              </a>
              <% if (active === 0) { %>
              <form
                action="/members/<%= member.member_id %>/delete"
                method="POST"
                class="d-inline m-0 p-0"
                data-confirm="Are you sure you want to delete <%= member.name %>? This will permanently remove their member record."
                data-btn="Delete Member"
                data-title="Delete Member"
                data-variant="danger"
              >
                <button
                  type="submit"
                  class="members-action-btn members-action-delete"
                  title="Delete <%= member.name %>"
                >
                  <i class="bi bi-trash3" aria-hidden="true"></i>
                  <span class="visually-hidden">Delete</span>
                </button>
              </form>
              <% } else { %>
              <button
                type="button"
                class="members-action-btn members-action-disabled"
                disabled
                title="Cannot delete: member has <%= active %> <%= active === 1 ? 'active loan' : 'active loans' %>"
              >
                <i class="bi bi-lock" aria-hidden="true"></i>
                <span class="visually-hidden">Delete restricted</span>
              </button>
              <% } %>
            </div>
          </td>
        </tr>
        <% }) %>
        <% } else { %>
        <tr>
          <td colspan="8" class="text-center py-5">
            <i
              class="bi bi-people fs-2 text-secondary mb-2 d-block"
              aria-hidden="true"
            ></i>
            <h2 class="h5 fw-bold mb-1 text-dark">No members found</h2>
            <p class="text-secondary small mb-3">
              No members have been registered yet.
            </p>
            <a href="/members/new" class="btn btn-success btn-sm px-3">
              <i class="bi bi-person-plus me-1" aria-hidden="true"></i> Register
              First Member
            </a>
          </td>
        </tr>
        <% } %>
        <tr id="membersSearchEmpty" class="d-none">
          <td colspan="8" class="text-center py-5">
            <i
              class="bi bi-search fs-3 text-secondary mb-2 d-block"
              aria-hidden="true"
            ></i>
            <h2 class="h6 fw-bold mb-1 text-dark">No matching members found</h2>
            <p class="text-secondary small mb-0">
              Try adjusting your search criteria or resetting filters.
            </p>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <script>
    (function () {
      const searchInput = document.getElementById('memberDirectorySearch');
      const typeFilter = document.getElementById('memberTypeFilter');
      const statusFilter = document.getElementById('memberStatusFilter');
      const resetBtn = document.getElementById('resetMemberFiltersBtn');
      const rows = Array.from(
        document.querySelectorAll('#membersTable .member-row'),
      );
      const emptyRow = document.getElementById('membersSearchEmpty');

      if (!searchInput || rows.length === 0) return;

      function debounce(fn, delay) {
        let timer = null;
        return function () {
          clearTimeout(timer);
          timer = setTimeout(() => fn.apply(this, arguments), delay);
        };
      }

      function filterMembers() {
        const query = searchInput.value.trim().toLowerCase();
        const selectedType = typeFilter.value;
        const selectedStatus = statusFilter.value;
        let visibleCount = 0;

        for (let i = 0; i < rows.length; i++) {
          const row = rows[i];
          const name = row.dataset.name || '';
          const email = row.dataset.email || '';
          const phone = row.dataset.phone || '';
          const id = row.dataset.id || '';
          const type = row.dataset.type || '';
          const status = row.dataset.status || '';

          const matchesQuery =
            !query ||
            name.includes(query) ||
            email.includes(query) ||
            phone.includes(query) ||
            id.includes(query);
          const matchesType = !selectedType || type === selectedType;
          const matchesStatus = !selectedStatus || status === selectedStatus;

          const isVisible = matchesQuery && matchesType && matchesStatus;
          row.classList.toggle('d-none', !isVisible);
          if (isVisible) visibleCount++;
        }

        if (emptyRow) {
          emptyRow.classList.toggle('d-none', visibleCount > 0);
        }
      }

      searchInput.addEventListener('input', debounce(filterMembers, 180));
      typeFilter.addEventListener('change', filterMembers);
      statusFilter.addEventListener('change', filterMembers);

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          searchInput.value = '';
          typeFilter.value = '';
          statusFilter.value = '';
          filterMembers();
        });
      }
    })();
  </script>
</div>
