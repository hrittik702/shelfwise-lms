<% layout('/layout/boilerplate') %>

<div class="book-form-page container py-4 py-lg-5">
  <!-- Back navigation -->
  <div class="mb-4">
    <a href="/books/<%= book.book_id %>" class="books-back-link">
      <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
      <span>Back to Book Details</span>
    </a>
  </div>

  <!-- Heading -->
  <div class="mb-4">
    <h1 class="books-title h3 fw-bold mb-1">Update Book</h1>
    <p class="books-subtitle mb-0 text-secondary">
      Modify book information and manage its inventory details.
    </p>
  </div>

  <!-- Update Form Card -->
  <div class="card books-form-card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex justify-content-between align-items-center">
      <div>
        <h2 class="h5 fw-bold mb-1 text-dark">Edit Book Details</h2>
        <span class="text-secondary small font-monospace">Book ID: #<%= book.book_id %></span>
      </div>
      <div>
        <span class="badge rounded-pill text-bg-light border text-dark">
          <%= book.available_copies %> of <%= book.total_copies %> Available
        </span>
      </div>
    </div>

    <div class="card-body p-3 p-md-4">
      <form
        action="/books/<%= book.book_id %>/update"
        method="POST"
        id="updateBookForm"
        data-confirm="Save changes to &ldquo;<%= book.title %>&rdquo;?"
        data-btn="Update Book"
        data-title="Update Book Details"
        data-variant="success"
      >
        <!-- Section 1: Core Information -->
        <div class="books-form-section mb-4">
          <div class="books-section-label text-uppercase text-secondary small fw-bold mb-3">Core Information</div>

          <!-- Title -->
          <div class="mb-3">
            <label for="title" class="form-label fw-semibold">
              Book Title <span class="text-danger">*</span>
            </label>
            <input
              type="text"
              class="form-control"
              id="title"
              name="title"
              value="<%= book.title %>"
              maxlength="100"
              required
            >
          </div>

          <!-- Author and ISBN -->
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="author" class="form-label fw-semibold">
                Author <span class="text-danger">*</span>
              </label>
              <input
                type="text"
                class="form-control"
                id="author"
                name="author"
                value="<%= book.author %>"
                maxlength="50"
                required
              >
            </div>

            <div class="col-12 col-md-6">
              <label for="isbn" class="form-label fw-semibold">
                ISBN <span class="text-danger">*</span>
              </label>
              <input
                type="text"
                class="form-control font-monospace"
                id="isbn"
                name="isbn"
                value="<%= book.isbn %>"
                minlength="13"
                maxlength="13"
                pattern="[0-9]{13}"
                inputmode="numeric"
                title="ISBN must contain exactly 13 numeric digits."
                required
              >
              <div class="form-text small text-secondary">
                Exact 13 digits without hyphens.
              </div>
            </div>
          </div>
        </div>

        <hr class="my-4 text-muted opacity-25">

        <!-- Section 2: Publication & Category -->
        <div class="books-form-section mb-4">
          <div class="books-section-label text-uppercase text-secondary small fw-bold mb-3">Publication &amp; Category</div>

          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="publisher" class="form-label fw-semibold">Publisher</label>
              <input
                type="text"
                class="form-control"
                id="publisher"
                name="publisher"
                value="<%= book.publisher || '' %>"
                maxlength="50"
              >
            </div>

            <div class="col-12 col-md-6">
              <label for="pub_year" class="form-label fw-semibold">
                Publication Year <span class="text-danger">*</span>
              </label>
              <input
                type="number"
                class="form-control font-monospace"
                id="pub_year"
                name="pub_year"
                value="<%= book.pub_year %>"
                min="1901"
                max="2155"
                required
              >
            </div>

            <div class="col-12">
              <label for="category_id" class="form-label fw-semibold">
                Category <span class="text-danger">*</span>
              </label>
              <select class="form-select" id="category_id" name="category_id" required>
                <% categories.forEach(category => { %>
                  <option
                    value="<%= category.category_id %>"
                    <%= String(category.category_id) === String(book.category_id) ? 'selected' : '' %>
                  >
                    <%= category.category_name %>
                  </option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <hr class="my-4 text-muted opacity-25">

        <!-- Section 3: Inventory Management -->
        <div class="books-form-section mb-4">
          <div class="books-section-label text-uppercase text-secondary small fw-bold mb-3">Inventory Details</div>

          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="total_copies" class="form-label fw-semibold">
                Total Physical Copies <span class="text-danger">*</span>
              </label>
              <input
                type="number"
                class="form-control font-monospace"
                id="total_copies"
                name="total_copies"
                value="<%= book.total_copies %>"
                min="0"
                step="1"
                required
              >
              <div class="form-text small text-secondary">
                Cannot be lower than the number of copies currently issued to members.
              </div>
            </div>

            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold text-secondary">
                Currently Available for Loan
              </label>
              <div class="form-control bg-light font-monospace text-dark fw-bold" aria-readonly="true">
                <%= book.available_copies %> copies available
              </div>
              <div class="form-text small text-secondary">
                Calculated dynamically from active circulation.
              </div>
            </div>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 pt-3 border-top">
          <a href="/books/<%= book.book_id %>" class="books-btn-secondary px-4">Cancel</a>
          <button type="submit" class="books-btn-primary">
            <i class="bi bi-check2-circle books-btn-icon-gold me-1" aria-hidden="true"></i>
            <span>Update Book</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
