<% layout('/layout/boilerplate') %>

<div class="book-detail-page container py-4 py-lg-5">
  <%
    const fmt = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
    const total = Number(book.total_copies) || 0;
    const available = Number(book.available_copies) || 0;
    const issued = Math.max(0, total - available);
    const isAvailable = available > 0;
    const loans = (typeof activeLoans !== 'undefined' && Array.isArray(activeLoans)) ? activeLoans : [];
  %>

  <!-- Back navigation -->
  <div class="mb-4">
    <a href="/books" class="books-back-link">
      <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
      <span>Back to Book Catalog</span>
    </a>
  </div>

  <!-- Header & Actions -->
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 mb-4">
    <div>
      <h1 class="books-title h3 fw-bold mb-1"><%= book.title %></h1>
      <p class="books-subtitle mb-0 text-secondary">
        Written by <strong><%= book.author %></strong> &middot; Category: <span class="badge text-bg-light border text-capitalize"><%= book.category_name || 'General' %></span>
      </p>
    </div>

    <div class="d-flex align-items-center gap-2 flex-shrink-0">
      <a href="/books/<%= book.book_id %>/update" class="books-btn-secondary btn-sm">
        <i class="bi bi-pencil me-1" aria-hidden="true"></i>
        <span>Edit Book</span>
      </a>
      <% if (isAvailable) { %>
        <a href="/circulation/issue?book_id=<%= book.book_id %>" class="books-btn-primary btn-sm">
          <i class="bi bi-journal-plus books-btn-icon-gold me-1" aria-hidden="true"></i>
          <span>Issue Book</span>
        </a>
      <% } %>
    </div>
  </div>

  <div class="row g-4">
    <!-- LEFT: Main Information & Active Borrowers -->
    <div class="col-12 col-lg-8">
      
      <!-- Book Specifications Card -->
      <div class="card books-card mb-4 shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex justify-content-between align-items-center">
          <h2 class="h5 fw-bold mb-0 text-dark">Book Specifications</h2>
          <span class="text-secondary small font-monospace">Catalog ID: #<%= book.book_id %></span>
        </div>

        <div class="card-body p-3 p-md-4">
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <div class="text-secondary small mb-1">Title</div>
              <div class="fw-semibold text-dark fs-6"><%= book.title %></div>
            </div>

            <div class="col-12 col-md-6">
              <div class="text-secondary small mb-1">Author</div>
              <div class="fw-semibold text-dark"><%= book.author %></div>
            </div>

            <div class="col-6 col-md-4">
              <div class="text-secondary small mb-1">ISBN</div>
              <div class="fw-semibold text-dark font-monospace"><%= book.isbn %></div>
            </div>

            <div class="col-6 col-md-4">
              <div class="text-secondary small mb-1">Publisher</div>
              <div class="text-dark"><%= book.publisher || '—' %></div>
            </div>

            <div class="col-6 col-md-4">
              <div class="text-secondary small mb-1">Publication Year</div>
              <div class="text-dark font-monospace"><%= book.pub_year %></div>
            </div>
          </div>

          <hr class="my-4 text-muted opacity-25">

          <!-- Inventory Breakdown Metrics -->
          <div class="books-section-label text-uppercase text-secondary small fw-bold mb-3">Inventory Breakdown</div>
          <div class="row g-3">
            <div class="col-4">
              <div class="p-3 bg-light rounded-3 text-center border">
                <div class="text-secondary small mb-1">Total Copies</div>
                <div class="fs-4 fw-bold text-dark font-monospace"><%= total %></div>
              </div>
            </div>
            <div class="col-4">
              <div class="p-3 bg-light rounded-3 text-center border">
                <div class="text-secondary small mb-1">Available</div>
                <div class="fs-4 fw-bold font-monospace <%= isAvailable ? 'text-success' : 'text-danger' %>"><%= available %></div>
              </div>
            </div>
            <div class="col-4">
              <div class="p-3 bg-light rounded-3 text-center border">
                <div class="text-secondary small mb-1">Issued</div>
                <div class="fs-4 fw-bold text-secondary font-monospace"><%= issued %></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Active Borrowers Table -->
      <div class="card books-card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white border-bottom p-3 p-md-4 d-flex justify-content-between align-items-center">
          <div>
            <h2 class="h5 fw-bold mb-0 text-dark">Current Borrowers</h2>
            <p class="text-secondary small mb-0">Active loans for this title</p>
          </div>
          <span class="badge rounded-pill bg-light text-dark border">
            <%= loans.length %> active
          </span>
        </div>

        <div class="card-body p-0">
          <% if (loans.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0 books-table">
                <thead>
                  <tr>
                    <th scope="col" class="ps-3 text-center" style="width: 44px;">#</th>
                    <th scope="col">Member</th>
                    <th scope="col">Type</th>
                    <th scope="col" class="text-center">Issued On</th>
                    <th scope="col" class="text-center">Due Date</th>
                    <th scope="col" class="text-center">Status</th>
                    <th scope="col" class="pe-3 text-end">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% loans.forEach((l, idx) => {
                    const days = Number(l.days_overdue) || 0;
                  %>
                    <tr>
                      <td class="ps-3 text-center text-secondary small"><%= idx + 1 %></td>
                      <td class="fw-semibold">
                        <a href="/members/<%= l.member_id %>" class="books-title-link">
                          <%= l.member_name %>
                        </a>
                      </td>
                      <td>
                        <span class="badge rounded-pill text-bg-light border text-dark fw-normal text-capitalize">
                          <%= l.member_type %>
                        </span>
                      </td>
                      <td class="text-center small text-nowrap font-monospace"><%= fmt(l.issue_date) %></td>
                      <td class="text-center small text-nowrap font-monospace <%= days > 0 ? 'text-danger fw-semibold' : '' %>">
                        <%= fmt(l.due_date) %>
                      </td>
                      <td class="text-center text-nowrap">
                        <% if (days > 0) { %>
                          <span class="circ-status-badge circ-status-overdue"><%= days %> day<%= days === 1 ? '' : 's' %> overdue</span>
                        <% } else if (days === 0) { %>
                          <span class="circ-status-badge circ-status-due-today">Due today</span>
                        <% } else { %>
                          <span class="circ-status-badge circ-status-active"><%= Math.abs(days) %> day<%= days === -1 ? '' : 's' %> left</span>
                        <% } %>
                      </td>
                      <td class="pe-3 text-end">
                        <a href="/circulation/<%= l.issue_id %>/return" class="btn btn-outline-secondary btn-sm">
                          Return
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-5 px-3">
              <i class="bi bi-journal-check fs-2 text-secondary mb-2 d-block" aria-hidden="true"></i>
              <h3 class="h6 fw-bold text-dark mb-1">No active loans</h3>
              <p class="text-secondary small mb-0">
                All copies of this title are currently on shelf.
              </p>
            </div>
          <% } %>
        </div>
      </div>

    </div>

    <!-- RIGHT: Status Sidebar & Safe Deletion -->
    <div class="col-12 col-lg-4">
      <div class="card books-card shadow-sm border-0 rounded-4 overflow-hidden bg-white mb-4 position-sticky" style="top: 1.5rem;">
        <div class="card-header bg-white border-bottom p-3">
          <h2 class="h6 fw-bold mb-0 text-dark">Availability Status</h2>
        </div>
        <div class="card-body p-3 p-md-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="text-secondary small">Current Status:</span>
            <% if (isAvailable) { %>
              <span class="circ-status-badge circ-status-active">
                <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i> Available
              </span>
            <% } else { %>
              <span class="circ-status-badge circ-status-overdue">
                <i class="bi bi-x-circle-fill me-1" aria-hidden="true"></i> Unavailable
              </span>
            <% } %>
          </div>

          <div class="p-3 bg-light rounded-3 mb-3 border">
            <div class="d-flex justify-content-between mb-1">
              <span class="text-secondary small">Total copies</span>
              <span class="fw-semibold text-dark font-monospace"><%= total %></span>
            </div>
            <div class="d-flex justify-content-between mb-1">
              <span class="text-secondary small">Currently on loan</span>
              <span class="fw-semibold text-dark font-monospace"><%= issued %></span>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-secondary small">Shelf ready</span>
              <span class="fw-bold text-success font-monospace"><%= available %></span>
            </div>
          </div>

          <!-- Danger Zone: Deletion with confirmation -->
          <div class="pt-3 border-top">
            <div class="text-secondary small mb-2">
              <i class="bi bi-shield-exclamation me-1 text-secondary" aria-hidden="true"></i>
              <%= issued > 0 ? 'Cannot delete book while copies are on loan.' : 'Deletion permanently removes this title from the catalog.' %>
            </div>
            <% if (issued === 0) { %>
              <form
                action="/books/<%= book.book_id %>/delete"
                method="POST"
                data-confirm="Are you sure you want to delete '<%= book.title %>'? This will permanently remove the title from the library catalog."
                data-btn="Delete Book"
                data-title="Delete Book"
                data-variant="danger"
              >
                <button type="submit" class="books-btn-danger w-100">
                  <i class="bi bi-trash3 me-1" aria-hidden="true"></i> Delete Book
                </button>
              </form>
            <% } else { %>
              <button type="button" class="books-btn-disabled w-100" disabled title="Copies currently on loan">
                <i class="bi bi-lock me-1" aria-hidden="true"></i> Delete Book (Restricted)
              </button>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
